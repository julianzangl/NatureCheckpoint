# Copy to .env and fill in. Never commit .env.

# --- Sensor node (Raspberry Pi) ---
STATION_ID=station-1
# Demo: one Pi hosts both checkpoints and also publishes its readings for these IDs.
STATION_IDS=
SAMPLE_INTERVAL_S=10
# Card check-ins from the Pi's NFC readers (generate both with `openssl rand -hex 24`).
BACKEND_URL=http://localhost:8000
DEVICE_TOKEN=
CARD_SALT=

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Broker user of the mqtt-ingest service (server stack)
INGEST_MQTT_USERNAME=ingest
INGEST_MQTT_PASSWORD=

# --- InfluxDB ---
INFLUXDB_URL=http://localhost:8086
# Any long random string, e.g. `openssl rand -hex 32`. Becomes the admin token on first start.
INFLUXDB_TOKEN=
# Password of the InfluxDB web UI user "admin" (min. 8 characters)
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORG=naturecheckpoint
INFLUXDB_BUCKET=environment

# --- Backend ---
DATABASE_PATH=data/naturecheckpoint.db
PUBLIC_BASE_URL=http://localhost:8000
# Stamp rules (defaults shown)
REWARD_STAMPS=6
REWARD_MIN_STATIONS=2
CHECKIN_RATE_LIMIT=10
CHECKIN_RATE_WINDOW_S=60

# --- ngrok (public HTTPS URL for the NFC tags) ---
NGROK_AUTHTOKEN=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
