{
  "uid": "nc-environment",
  "title": "NatureCheckpoint – Environment",
  "description": "Sensor history and current walk conditions per checkpoint (#13).",
  "tags": [
    "naturecheckpoint"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(bucket: \"environment\", tag: \"station_id\")",
        "definition": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(bucket: \"environment\", tag: \"station_id\")",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Walk conditions now",
      "description": "Latest rating per station from the last 15 minutes. 'No data' means the station sent nothing in that time.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"environment\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"condition\" and r.station_id =~ /^${station:regex}$/)\n  |> last()\n  // Stat panels colour numbers more reliably than strings, so map the level to a number.\n  |> map(fn: (r) => ({r with _value: if r._value == \"good\" then 1 else if r._value == \"fair\" then 2 else if r._value == \"poor\" then 3 else 0}))\n  |> keep(columns: [\"_time\", \"_value\", \"station_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SENSOR FAULT",
                  "color": "#9e9e9e",
                  "index": 0
                },
                "1": {
                  "text": "GOOD",
                  "color": "#2e7d32",
                  "index": 1
                },
                "2": {
                  "text": "FAIR",
                  "color": "#f9a825",
                  "index": 2
                },
                "3": {
                  "text": "POOR",
                  "color": "#c62828",
                  "index": 3
                }
              }
            }
          ],
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#9e9e9e"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#9e9e9e",
                "value": null
              }
            ]
          },
          "displayName": "${__field.labels.station_id}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Last seen",
      "description": "Time of the last message (readings or health) per station.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"environment\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => (r._measurement == \"environment\" or r._measurement == \"device_health\") and r.station_id =~ /^${station:regex}$/)\n  // Drop the values first: readings and health have different value types.\n  |> keep(columns: [\"station_id\", \"_time\"])\n  |> group(columns: [\"station_id\"])\n  |> max(column: \"_time\")\n  |> group()\n  |> rename(columns: {station_id: \"Station\", _time: \"Last seen\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Station": 0,
              "Last seen": 1
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\" and r.station_id =~ /^${station:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"station_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.station_id}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Humidity",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"humidity\" and r.station_id =~ /^${station:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"station_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.station_id}",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Light",
      "description": "Raw value of the analogue light sensor (relative, not lux).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"light\" and r.station_id =~ /^${station:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"station_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.station_id}",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
